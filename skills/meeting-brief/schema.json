{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meeting brief output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "meetingRevision",
    "summary",
    "sourceIds"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "meetingRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "sourceIds": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    }
  }
}
